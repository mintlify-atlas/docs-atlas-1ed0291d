  "keyFeatures": [
    "Multi-tenant white-labeling with per-company branding (colors, logo, email domain)",
    "Project management with Kanban board and role-based membership (OWNER, MEMBER, VIEWER)",
    "Full HR module: recruitment via Google Drive sync, guard compliance tracking, document generation",
    "Custodias management with PDF generation and payroll matrix (HACIENDA, PUERTO, VIP)",
    "Cacao inventory system: receptions, lots, settlements, shipments, payables/receivables",
    "Sales module: leads, client visits, contract templates with docx merge, webhooks",
    "AI chat assistant powered by GitHub Models (gpt-4o-mini) with custom agents and scopes",
    "Section-level permission system (CompanySection + UserPermission) per company",
    "Admin dashboard with user stats, project health indicators, and tool inventory",
    "JWT authentication with role guards (ADMIN, MANAGER, EMPLOYEE) and bcrypt password hashing"
  ],
